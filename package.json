{
  "name": "my-site",
  "version": "1.0.0",
  "description": "Personal site built with Eleventy",
  "scripts": {
    "start": "eleventy --serve",
    "build": "node scripts/fetch-github.js && node scripts/fetch-weather.js && eleventy && node scripts/og-images.js && pagefind --site _site",
    "fetch": "node scripts/fetch-github.js",
    "fetch:weather": "node scripts/fetch-weather.js",
    "blog:new": "node tools/blogpub/cli.js new",
    "blog:publish": "node tools/blogpub/cli.js publish",
    "blog:syndicate": "node tools/blogpub/cli.js syndicate"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^2.0.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "katex": "^0.18.4",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-katex": "^2.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-toc-done-right": "^4.2.0",
    "satori": "^0.29.0"
  }
}
