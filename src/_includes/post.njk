---
layout: base.njk
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ (description or excerpt or "") | dump | safe }},
  "datePublished": "{{ page.date | isoDate }}",
  "dateModified": "{{ page.date | isoDate }}",
  "author": { "@type": "Person", "name": {{ site.author.name | dump | safe }} },
  "publisher": { "@type": "Person", "name": {{ site.author.name | dump | safe }} },
  "url": "{{ site.url }}{{ page.url }}",
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}"{% if coverImage %},
  "image": "{{ site.url }}{{ coverImage }}"{% endif %}
}
</script>
<main id="main">
<article class="post-full" data-pagefind-body>

  <header>
    <div class="post-meta-row">
      <time class="post-date" datetime="{{ page.date | isoDate }}" data-pagefind-meta="date">{{ page.date | dotDate }}</time>
      <span class="reading-time" data-pagefind-meta="reading_time">{{ content | readingTime }}</span>
      <button class="medium-btn" type="button" id="mediumToggle" data-pagefind-ignore aria-pressed="false" aria-label="Toggle Medium reading mode">
        <span class="md-label">medium mode</span>
      </button>
    </div>
    <h1 class="post-full-title" data-pagefind-meta="title">{{ title }}</h1>
    {% if tags and (tags | displayTags).length %}
    <div class="post-tags">
      {% for tag in tags | displayTags %}<span class="tag-pill">{{ tag }}</span>{% endfor %}
    </div>
    {% endif %}
  </header>

  {% if coverImage %}
  <figure class="post-cover">
    <img src="{{ coverImage }}" alt="{{ coverImageAlt or title }}">
  </figure>
  {% endif %}

  {{ content | toc | safe }}

  <div class="post-body glass-surface">
    {{ content | safe }}
    <p class="post-signature">sent from Aegon</p>
  </div>

  {# Mermaid init lives here (inside #main) rather than base.njk: nav.js's
     reviveScripts() only re-executes <script> tags inside the swapped
     #main region on a soft navigation. From base.njk it only ever ran once,
     on whichever page first loaded — soft-navigating into a later post with
     diagrams left them as raw, unrendered source (Prism just syntax-
     highlights the mermaid fence as code, which is all that showed). #}
  <script src="/js/mermaid-init.js"></script>

  {%- if series and collections.seriesMap[series] -%}
  {%- set parts = collections.seriesMap[series] -%}
  <nav class="series-nav" aria-label="Series navigation">
    <p class="series-nav-label">Part of the series <strong>{{ series }}</strong></p>
    <ol>
      {%- for part in parts %}
      <li{% if part.url == page.url %} class="series-current" aria-current="page"{% endif %}>
        {% if part.url == page.url %}{{ part.data.title }}{% else %}<a href="{{ part.url }}">{{ part.data.title }}</a>{% endif %}
      </li>
      {%- endfor %}
    </ol>
  </nav>
  {%- endif -%}

  {%- set related = collections.posts | relatedPosts(tags, page.url, 3) -%}
  {%- if related.length -%}
  <section class="related-posts" aria-label="Related posts">
    <p class="related-label">Related reading</p>
    <ul>
      {%- for post in related %}
      <li><a href="{{ post.url }}">{{ post.data.title }}</a> <span class="related-date">{{ post.date | dotDate }}</span></li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif -%}

  {%- if site.newsletter.action -%}
  <section class="newsletter" aria-label="Newsletter signup">
    <p class="newsletter-label">Get new posts by email</p>
    <form class="newsletter-form" action="{{ site.newsletter.action }}" method="post" target="_blank">
      <input type="email" name="email" placeholder="you@example.com" required aria-label="Email address">
      <button type="submit">subscribe</button>
    </form>
  </section>
  {%- endif -%}

  <div class="post-footer">
    <a class="back-link" href="/blog/">← back to all writing</a>
  </div>

</article>
</main>
