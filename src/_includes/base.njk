<!DOCTYPE html>
<html lang="{{ site.language }}" data-theme="light" data-post-count="{{ collections.posts.length }}"{% if page.url == "/about/" %} data-page="about"{% endif %}{% if "/blog/" in page.url %} class="reading-mode"{% endif %}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# these can't read CSS variables — keep in sync with theme.css's --bg
     for [data-theme="light"]/[data-theme="dark"] by hand if that ever changes #}
  <meta name="theme-color" content="#F0EAD6" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1B1B1B" media="(prefers-color-scheme: dark)">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or excerpt or site.tagline }}">

  {# ── canonical + social cards ── #}
  {%- set canonicalUrl = site.url + page.url -%}
  {%- set ogTitle = title or site.name -%}
  {%- set ogDesc = description or excerpt or site.tagline -%}
  {%- set isPost = "/blog/" in page.url and page.url != "/blog/" -%}
  {%- if coverImage -%}{%- set ogImage = site.url + coverImage -%}
  {%- elif isPost -%}{%- set ogImage = site.url + "/og/" + page.fileSlug + ".png" -%}
  {%- else -%}{%- set ogImage = site.url + "/og-default.png" -%}{%- endif -%}
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:type" content="{% if isPost %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ ogTitle }}">
  <meta property="og:description" content="{{ ogDesc }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ ogImage }}">
  {%- if isPost %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta property="article:author" content="{{ site.author.name }}">
  {%- for tag in tags | displayTags %}
  <meta property="article:tag" content="{{ tag }}">
  {%- endfor %}
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle }}">
  <meta name="twitter:description" content="{{ ogDesc }}">
  <meta name="twitter:image" content="{{ ogImage }}">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} RSS" href="/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/style.css">
  {# KaTeX stylesheet — only on blog pages, the only place math renders #}
  {% if "/blog/" in page.url %}<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous">{% endif %}
  {# Chitra's weather color, baked in at build time (see scripts/fetch-weather.js) #}
  <style>
    :root {
      --chitra-color: {{ weather.color or '#F5D77A' }};
      --chitra-color-rgb: {{ weather.colorRgb or '245,215,122' }};
    }
  </style>

  {# Anti-flash script — applies theme before paint #}
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch(e) {}
    })();
  </script>
</head>
<body>

{# ── BACKGROUND SCENE (fixed, site-wide) ── #}
<div class="scene" aria-hidden="true">
  <canvas class="scene-sky" id="sceneSky"></canvas>
  <div class="scene-ridge">
    <div class="ridge-far"></div>
    <div class="ridge-near"></div>
    <div class="ridge-trees"></div>
  </div>
  <div class="scene-mist scene-mist-bottom"></div>
  <div class="scene-mist scene-mist-top"></div>
</div>

<a href="#main" class="skip-link">skip to content</a>

<div class="wrap">

  {# ── UTILITY STRIP ── #}
  <div class="utility-strip glass-surface">
    <div class="status">
      <span class="dot" aria-hidden="true"></span>
      <span id="statusText" data-username="{{ site.githubUsername }}">
        {% if github.configured and github.available %}
          <span class="label">currently building</span>
          <a href="{{ github.repoUrl }}" target="_blank" rel="noopener">{{ github.repoName }}</a>
          {% if github.description %}<span class="label">— {{ github.description }}</span>{% endif %}
        {% else %}
          <span class="label">{{ site.manualStatus }}</span>
        {% endif %}
      </span>
    </div>
    <div class="tools">
      {% if page.url != "/about/" %}
      <span class="construction">★ under construction ★</span>
      <button class="theme-switch" id="themeSwitch" aria-label="Toggle light and dark theme" type="button">
        <span class="theme-switch-knob">
          <span id="themeIcon" aria-hidden="true">☾</span>
        </span>
      </button>
      {% endif %}
      <button class="calm-toggle" id="calmToggle" aria-pressed="false" aria-label="Toggle calm mode" type="button">
        <span class="calm-icon" aria-hidden="true">◐</span>
        <span class="calm-label">calm mode</span>
      </button>
      <button class="mute-toggle" id="muteToggle" type="button" aria-label="Toggle background music">♪</button>
    </div>
  </div>

  {# ── HEADER ── #}
  <header class="glass-surface">
    <h1><a href="/">{{ site.nameDisplay | safe }}</a></h1>
    <p class="tagline">{{ site.tagline }}</p>
    <p class="sub-tagline"><span class="star" aria-hidden="true">★</span> {{ site.subTagline }} <span class="star" aria-hidden="true">★</span></p>

    <div class="nav-row">
      <nav aria-label="Main navigation">
        <a href="/" {% if page.url == "/" %}class="active" aria-current="page"{% endif %}>home</a>
        <a href="/blog/" {% if "/blog/" in page.url %}class="active" aria-current="page"{% endif %}>blog</a>
        <a href="/about/" {% if page.url == "/about/" %}class="active" aria-current="page"{% endif %}>about</a>
        <a href="/feeds/" {% if page.url == "/feeds/" %}class="active" aria-current="page"{% endif %}>feeds</a>
        <a class="rss-link" href="/feed.xml" aria-label="RSS feed">
          <svg class="rss-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/></svg>
          rss
        </a>
      </nav>
      <div class="auth-buttons">
        <button class="btn" type="button" onclick="openModal('login')">log in</button>
        <button class="btn btn-primary" type="button" onclick="openModal('signup')">sign up</button>
      </div>
    </div>
  </header>

  {# ── HERO CAPTION (homepage only, floats over the scene) ── #}
  {% if page.url == "/" %}
  <p class="hero-caption">From here I watch you flicker and fade, tiny as dust on the wind you cannot stop what comes, and neither can I; so we simply burn, you and I, beautiful for a moment, though I may already be the light of something long dead.</p>
  {% endif %}

  {{ content | safe }}

  <footer class="glass-surface">
    <p> coded on aegon · no analytics OR tracking </p>
    <p><a href="/feed.xml">rss</a></p>
  </footer>

</div>

{# ── auth modal (placeholder) ── #}
<div class="modal-backdrop" id="authModal" onclick="if(event.target===this)closeModal()" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal glass-surface">
    <h3 id="modalTitle">log in</h3>
    <p id="modalDesc">Welcome back. Pick up where you left off.</p>
    <input type="email" placeholder="email" aria-label="Email">
    <input type="password" placeholder="password" aria-label="Password">
    <div class="modal-actions">
      <button class="btn btn-primary" type="button">continue</button>
      <button class="modal-close" type="button" onclick="closeModal()">cancel</button>
    </div>
  </div>
</div>

{# ── Medium Mode's own exit affordances (site.js wires the behavior) —
   fixed, hidden outside html.medium-mode, so they survive nav.js's #main
   swaps untouched and never need re-inserting ── #}
<button id="mediumExit" type="button" aria-label="Exit Medium Mode">✕</button>
<button id="mediumDarkToggle" type="button" aria-label="Toggle Medium Mode's light/dark">☾</button>

<audio id="calmAudio" src="/audio/flowers-of-the-forest.mp3" loop preload="none"></audio>

{# ── first-visit welcome popup — hidden by default to avoid a flash ── #}
<div class="welcome-overlay" id="welcome" hidden>
  <div class="welcome-card glass-surface" role="dialog" aria-modal="true" aria-labelledby="welcome-title">
    <div class="welcome-orb" aria-hidden="true"></div>
    <h2 id="welcome-title" class="welcome-title">Hello boss, howzya</h2>
    <div class="welcome-theme">
      <div class="welcome-modes">
        <button type="button" data-mode="light" id="wm-light">light mode</button>
        <button type="button" data-mode="dark" id="wm-dark">dark mode</button>
      </div>
    </div>
    <div class="welcome-theme">
      <div class="welcome-modes">
        <button type="button" id="wm-calm-off">calm mode: off</button>
        <button type="button" id="wm-calm-on">calm mode: on</button>
      </div>
    </div>
    <label class="welcome-music">
      <input type="checkbox" id="welcome-music-check">
      <span>music</span>
    </label>
    <button type="button" class="welcome-enter" id="welcome-enter">continue (with defaults) →</button>
  </div>
</div>

<script src="/js/site.js"></script>
<script src="/js/nav.js"></script>
<script src="/js/soft-scroll.js"></script>
<script src="/js/spiral.js"></script>
<script src="/js/embeds.js" defer></script>
<script src="/js/lightbox.js" defer></script>
</body>
</html>
