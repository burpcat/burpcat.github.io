---
layout: base.njk
title: writing
pagination:
  data: collections.posts
  size: 10
  alias: posts
permalink: "{% if pagination.pageNumber == 0 %}/blog/{% else %}/blog/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---

<main id="main">
<section>
  <p class="section-label">— ALL WRITING</p>

  {# ── search (Pagefind's low-level JS API, generated into /pagefind/ at
     build — driven directly instead of the stock PagefindUI widget so the
     results can be a custom spotlight overlay, see src/js/search.js) ── #}
  <button class="search-trigger" id="searchTrigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="searchOverlay">
    <svg class="search-trigger-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <span>Search all writing…</span>
  </button>

  <div class="search-overlay" id="searchOverlay" role="presentation">
    <div class="search-panel glass-surface" role="dialog" aria-modal="true" aria-label="Search all writing">
      <div class="search-input-row">
        <svg class="search-input-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input class="search-input" type="text" autocomplete="off" spellcheck="false" placeholder="Search all writing…" aria-label="Search all writing">
        <button class="search-clear" type="button" hidden>Clear</button>
        <button class="search-close" type="button" aria-label="Close search">esc</button>
      </div>
      <div class="search-results" aria-live="polite"></div>
    </div>
  </div>

  <script src="/js/search.js"></script>

  {% if posts.length %}
    {% for post in posts %}
    <article class="post-item glass-surface">
      {% if post.data.coverImage %}
      <a class="post-thumb" href="{{ post.url }}"><img src="{{ post.data.coverImage }}" alt="{{ post.data.coverImageAlt or post.data.title }}" loading="lazy"></a>
      {% endif %}
      <div class="post-meta-row">
        <time class="post-date" datetime="{{ post.date | isoDate }}">{{ post.date | dotDate }}</time>
        <span class="reading-time">{{ post.templateContent | readingTime }}</span>
        {% if post.data.series %}<span class="series-badge">{{ post.data.series }}</span>{% endif %}
      </div>
      <h2 class="post-title">
        {% if post.date | isRecent(14) %}<span class="new-badge" aria-label="New post">NEW</span>{% endif %}
        <a href="{{ post.url }}">{{ post.data.title | safe }}</a>
      </h2>
      {% if post.data.excerpt %}<p class="post-excerpt">{{ post.data.excerpt }}</p>{% endif %}
      {% if post.data.tags and (post.data.tags | displayTags).length %}
      <div class="post-tags">
        {% for tag in post.data.tags | displayTags %}<a class="tag-pill" href="/tags/{{ tag | slug }}/">{{ tag }}</a>{% endfor %}
      </div>
      {% endif %}
      <a class="read-link" href="{{ post.url }}">read →</a>
    </article>
    {% endfor %}

    {% if pagination.pages.length > 1 %}
    <nav class="pagination" aria-label="Pagination">
      {% if pagination.href.previous %}<a class="page-prev" href="{{ pagination.href.previous }}">← newer</a>{% endif %}
      <span class="page-count">page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
      {% if pagination.href.next %}<a class="page-next" href="{{ pagination.href.next }}">older →</a>{% endif %}
    </nav>
    {% endif %}

    <p class="browse-tags"><a href="/tags/">browse all tags →</a></p>
  {% else %}
    <p class="empty-state">
      No posts yet. To write your first one, create a file like <code>src/posts/2025-06-22-my-first-post.md</code> with this frontmatter:
    </p>
    <pre style="background:#0d1117;color:#e6edf3;border:1px solid #30363d;border-radius:6px;padding:16px 20px;font-size:13px;line-height:1.6;margin-top:14px;overflow-x:auto;">---
title: Hello, world
date: 2025-06-22
excerpt: A short summary that shows on the listing page.
---

Your content in Markdown here.</pre>
  {% endif %}
</section>
</main>
